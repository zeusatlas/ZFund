# ==============================================================================
# ZFund Backend Environment Configuration
# Copy this file to .env and adjust the values for your environment.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Application
NODE_ENV=development
PORT=2077
API_BASE_URL=http://localhost:2077
API_PREFIX=/api/v1

# PostgreSQL Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=zfund_db
DB_SSL=false
# WARNING: synchronize should ONLY be true in development/testing.
# Production requires explicit, intentional configuration.
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false

# Redis Cache & Session Store
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false
REDIS_KEY_PREFIX=zfund:

# Authentication & Security
JWT_ACCESS_SECRET=dev_jwt_access_secret_super_secure_key_change_in_production_123456789
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_super_secure_key_change_in_production_987654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# NALO USSD Integration
# General dial code: *920*969#
# Project direct format: *920*969*<EVENT_CODE>#
NALO_USER_ID=NALOTest
NALO_AUTH_TOKEN=dev_nalo_auth_token_optional
NALO_DEFAULT_CODE=*920*969#
NALO_MAX_MESSAGE_LENGTH=120

# Paystack Payment Integration
PAYSTACK_SECRET_KEY=sk_test_placeholder_key_for_zfund_integration
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key_for_zfund_integration
PAYSTACK_BASE_URL=https://api.paystack.co
# Note: For Paystack webhooks, secret key is used to compute HMAC SHA512 signature
PAYSTACK_WEBHOOK_SECRET=sk_test_placeholder_key_for_zfund_integration

# SMS Notification Provider
# Available options: mock | arkesel | nalo
SMS_PROVIDER=mock
SMS_API_KEY=dev_sms_api_key_placeholder
SMS_SENDER_ID=ZFund
SMS_API_URL=https://sms.arkesel.com/api/v2/sms/send

# Document Upload & Storage (Private)
UPLOAD_DIR=storage/documents
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Structured Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Web app URL (used in the account-created SMS) and the super admin's phone,
# which is required because sign-in is by email + phone + SMS code.
FRONTEND_URL=http://localhost:3000
SEED_ADMIN_PHONE=
